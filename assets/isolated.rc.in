#pragma code_page(65001)
1 ICON "@ASSETS@/isolated.ico"
1 24 "@ASSETS@/isolated.manifest"

1 VERSIONINFO
FILEVERSION @VERSION_COMMA@
PRODUCTVERSION @VERSION_COMMA@
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Isolated"
      VALUE "FileDescription", "Isolated - run programs in a sandbox"
      VALUE "FileVersion", "@VERSION@"
      VALUE "InternalName", "isolated"
      VALUE "OriginalFilename", "isolated.exe"
      VALUE "ProductName", "Isolated"
      VALUE "ProductVersion", "@VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
